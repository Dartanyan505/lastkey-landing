---
import "../styles/global.css";

const { title = "LastKey - Plansız Seyahatlerin Anahtarı" } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Konumuna yakın otelleri keşfet, filtrele, haritada gör ve dakikalar içinde rezervasyonunu tamamla."
    />
    <meta name="theme-color" content="#0e1a2d" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <button class="to-top up-arrow-btn" type="button" aria-label="Yukarı çık">
      <svg class="up-arrow-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.5 14.5 12 9l5.5 5.5" />
      </svg>
    </button>
    <slot />

    <script is:inline>
      const scrollProgress = document.querySelector(".scroll-progress");
      const toTopButton = document.querySelector(".to-top");

      if (scrollProgress) {
        const updateScrollProgress = () => {
          const scrollTop = window.scrollY;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const progress = maxScroll > 0 ? Math.min(scrollTop / maxScroll, 1) : 0;
          scrollProgress.style.setProperty("--scroll-progress", progress.toFixed(4));
        };

        updateScrollProgress();
        window.addEventListener("scroll", updateScrollProgress, { passive: true });
        window.addEventListener("resize", updateScrollProgress);
      }

      if (toTopButton) {
        const toggleToTop = () => {
          toTopButton.classList.toggle("is-visible", window.scrollY > 520);
        };

        toggleToTop();
        window.addEventListener("scroll", toggleToTop, { passive: true });

        toTopButton.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      const supportsFinePointer = window.matchMedia("(pointer: fine)").matches;
      const cursorRing = document.querySelector(".cursor-ring");
      const cursorDot = document.querySelector(".cursor-dot");

      if (supportsFinePointer && cursorRing && cursorDot) {
        document.documentElement.classList.add("has-custom-cursor");

        const setDotState = (x, y) => {
          cursorDot.style.setProperty("--cursor-x", `${x}px`);
          cursorDot.style.setProperty("--cursor-y", `${y}px`);
        };

        const setRingState = (x, y) => {
          cursorRing.style.setProperty("--cursor-x", `${x}px`);
          cursorRing.style.setProperty("--cursor-y", `${y}px`);
        };

        let targetX = window.innerWidth / 2;
        let targetY = window.innerHeight / 2;
        let ringX = targetX;
        let ringY = targetY;
        let rafId = 0;
        const ease = 0.4;

        const animateRing = () => {
          ringX += (targetX - ringX) * ease;
          ringY += (targetY - ringY) * ease;
          setRingState(ringX, ringY);
          rafId = window.requestAnimationFrame(animateRing);
        };

        setDotState(targetX, targetY);
        setRingState(ringX, ringY);
        rafId = window.requestAnimationFrame(animateRing);

        window.addEventListener("mousemove", (event) => {
          targetX = event.clientX;
          targetY = event.clientY;
          setDotState(targetX, targetY);
          cursorRing.classList.add("is-visible");
          cursorDot.classList.add("is-visible");
        });

        window.addEventListener("mouseout", (event) => {
          if (event.relatedTarget === null) {
            cursorRing.classList.remove("is-visible");
            cursorDot.classList.remove("is-visible");
          }
        });

        window.addEventListener("mousedown", () => {
          cursorRing.classList.add("is-down");
        });

        window.addEventListener("mouseup", () => {
          cursorRing.classList.remove("is-down");
        });

        window.addEventListener("mouseover", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const interactive = target.closest(
            "a, button, summary, input, textarea, select, [data-go], [data-dir]",
          );

          cursorRing.classList.toggle("is-link", Boolean(interactive));
        });

        window.addEventListener("pagehide", () => {
          window.cancelAnimationFrame(rafId);
        });
      }

      const FORM_ENDPOINT =
        "https://us-central1-deneme7-cf760.cloudfunctions.net/submitLandingForm";
      const NETWORK_ERROR_MESSAGE = "Şu an gönderilemiyor, lütfen tekrar dene.";
      const SUCCESS_MESSAGE = "Talebin alındı. En kısa sürede dönüş yapacağız.";
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const isLocalDev =
        window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

      const setFormStatus = (form, message) => {
        const statusEl = form.querySelector("[data-form-status]");
        if (statusEl) statusEl.textContent = message;
      };

      const setSubmittingState = (button, isSubmitting) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (isSubmitting) {
          button.disabled = true;
          button.textContent = "Gönderiliyor...";
          return;
        }
        button.disabled = false;
        const idleLabel = button.getAttribute("data-idle-label");
        if (idleLabel) button.textContent = idleLabel;
      };

      const formatClientError = (error) => {
        if (error instanceof DOMException && error.name === "AbortError") {
          return isLocalDev
            ? `${NETWORK_ERROR_MESSAGE} [timeout]`
            : NETWORK_ERROR_MESSAGE;
        }

        if (error instanceof TypeError) {
          return isLocalDev
            ? `${NETWORK_ERROR_MESSAGE} [network/cors] endpoint=${FORM_ENDPOINT}`
            : NETWORK_ERROR_MESSAGE;
        }

        if (error instanceof Error && error.message) return error.message;
        return "Gönderim başarısız oldu. Lütfen tekrar dene.";
      };

      const postLandingForm = async (payload) => {
        const controller = new AbortController();
        const timeoutId = window.setTimeout(() => controller.abort(), 12000);
        try {
          const response = await fetch(FORM_ENDPOINT, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });

          let responseBody = null;
          let responseText = "";
          try {
            responseText = await response.text();
            responseBody = responseText ? JSON.parse(responseText) : null;
          } catch {
            responseBody = null;
          }

          if (!response.ok || !responseBody?.ok) {
            const apiError =
              typeof responseBody?.error === "string" && responseBody.error.trim()
                ? responseBody.error.trim()
                : "Gönderim başarısız oldu. Lütfen tekrar dene.";
            const debugSuffix = isLocalDev
              ? ` [http:${response.status}]${responseText ? ` body=${responseText.slice(0, 180)}` : ""}`
              : "";
            throw new Error(`${apiError}${debugSuffix}`);
          }

          return responseBody;
        } finally {
          window.clearTimeout(timeoutId);
        }
      };

      const handleHotelListingSubmit = async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement)) return;

        const submitButton = form.querySelector('button[type="submit"]');
        const honeyInput = form.querySelector('input[name="_company"]');

        const hotelName = (form.querySelector('input[name="hotelName"]')?.value ?? "").trim();
        const contactName = (form.querySelector('input[name="ownerName"]')?.value ?? "").trim();
        const email = (form.querySelector('input[name="email"]')?.value ?? "").trim();
        const phone = (form.querySelector('input[name="phone"]')?.value ?? "").trim();
        const cityDistrict = (form.querySelector('input[name="location"]')?.value ?? "").trim();
        const roomCountRaw = (form.querySelector('input[name="roomCount"]')?.value ?? "").trim();
        const note = (form.querySelector('textarea[name="note"]')?.value ?? "").trim();
        const roomCount = Number(roomCountRaw);

        if (!hotelName || !contactName || !email || !phone || !cityDistrict || !roomCountRaw) {
          setFormStatus(form, "Lütfen zorunlu alanların tamamını doldur.");
          return;
        }

        if (!emailRegex.test(email)) {
          setFormStatus(form, "Lütfen geçerli bir e-posta adresi gir.");
          return;
        }

        if (!Number.isFinite(roomCount) || roomCount <= 0) {
          setFormStatus(form, "Oda sayısı 0'dan büyük bir sayı olmalıdır.");
          return;
        }

        if (honeyInput instanceof HTMLInputElement && honeyInput.value.trim().length > 0) {
          setFormStatus(form, SUCCESS_MESSAGE);
          form.reset();
          return;
        }

        setFormStatus(form, "");
        setSubmittingState(submitButton, true);

        try {
          await postLandingForm({
            formType: "hotel_listing",
            hotelName,
            contactName,
            email,
            phone,
            cityDistrict,
            roomCount,
            note,
          });
          form.reset();
          setFormStatus(form, SUCCESS_MESSAGE);
        } catch (error) {
          setFormStatus(form, formatClientError(error));
        } finally {
          setSubmittingState(submitButton, false);
        }
      };

      const handleSupportSubmit = async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement)) return;

        const submitButton = form.querySelector('button[type="submit"]');
        const honeyInput = form.querySelector('input[name="_company"]');

        const fullName = (
          form.querySelector('input[name="supportName"]')?.value ??
          form.querySelector('input[name="name"]')?.value ??
          ""
        ).trim();
        const email = (
          form.querySelector('input[name="supportEmail"]')?.value ??
          form.querySelector('input[name="email"]')?.value ??
          ""
        ).trim();
        const message = (
          form.querySelector('textarea[name="supportMessage"]')?.value ??
          form.querySelector('textarea[name="message"]')?.value ??
          ""
        ).trim();

        if (!fullName || !email || !message) {
          setFormStatus(form, "Lütfen zorunlu alanların tamamını doldur.");
          return;
        }

        if (!emailRegex.test(email)) {
          setFormStatus(form, "Lütfen geçerli bir e-posta adresi gir.");
          return;
        }

        if (honeyInput instanceof HTMLInputElement && honeyInput.value.trim().length > 0) {
          setFormStatus(form, SUCCESS_MESSAGE);
          form.reset();
          return;
        }

        setFormStatus(form, "");
        setSubmittingState(submitButton, true);

        try {
          await postLandingForm({
            formType: "support",
            fullName,
            email,
            message,
          });
          form.reset();
          setFormStatus(form, SUCCESS_MESSAGE);
        } catch (error) {
          setFormStatus(form, formatClientError(error));
        } finally {
          setSubmittingState(submitButton, false);
        }
      };

      const hotelListingForm = document.querySelector(
        'form[data-form-kind="hotel-application"]',
      );
      if (hotelListingForm instanceof HTMLFormElement) {
        hotelListingForm.addEventListener("submit", handleHotelListingSubmit);
      }

      const supportForms = [
        ...document.querySelectorAll('form[data-form-kind="application-support"], form[data-form-kind="landing-support"]'),
      ];
      supportForms.forEach((form) => {
        if (form instanceof HTMLFormElement) {
          form.addEventListener("submit", handleSupportSubmit);
        }
      });
    </script>
  </body>
</html>
