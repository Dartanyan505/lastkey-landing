---
import "../styles/global.css";

const { title = "LastKey — Son dakika konaklamanı yakala" } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Konumuna yakın otelleri keşfet, filtrele, haritada gör ve dakikalar içinde rezervasyonunu tamamla."
    />
    <meta name="theme-color" content="#0e1a2d" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />

    <script>
      const supportsFinePointer = window.matchMedia("(pointer: fine)").matches;
      const cursorRing = document.querySelector(".cursor-ring");
      const cursorDot = document.querySelector(".cursor-dot");

      if (supportsFinePointer && cursorRing && cursorDot) {
        document.documentElement.classList.add("has-custom-cursor");

        const setCursorState = (x, y) => {
          cursorDot.style.setProperty("--cursor-x", `${x}px`);
          cursorDot.style.setProperty("--cursor-y", `${y}px`);
          cursorRing.style.setProperty("--cursor-x", `${x}px`);
          cursorRing.style.setProperty("--cursor-y", `${y}px`);
        };

        window.addEventListener("mousemove", (event) => {
          setCursorState(event.clientX, event.clientY);
          cursorRing.classList.add("is-visible");
          cursorDot.classList.add("is-visible");
        });

        window.addEventListener("mousedown", () => {
          cursorRing.classList.add("is-down");
        });

        window.addEventListener("mouseup", () => {
          cursorRing.classList.remove("is-down");
        });

        window.addEventListener("mouseover", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const interactive = target.closest(
            "a, button, summary, input, textarea, select, .hero-phone, [data-go], [data-dir]",
          );

          cursorRing.classList.toggle("is-link", Boolean(interactive));
        });
      }
    </script>
  </body>
</html>
