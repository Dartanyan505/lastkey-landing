---
import "../styles/global.css";

const { title = "LastKey — Son dakika konaklamanı yakala" } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Konumuna yakın indirimli otelleri keşfet, karşılaştır ve rezervasyonunu dakikalar içinde tamamla."
    />
    <meta name="theme-color" content="#0e1a2d" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sora:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
