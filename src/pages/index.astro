---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
import ScreensGallery from "../components/ScreensGallery.astro";
import Features from "../components/Features.astro";
import HostSection from "../components/HostSection.astro";
import TrustSection from "../components/TrustSection.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQSection from "../components/FAQSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

import {
  nav,
  userValueProps,
  userScreenStory,
  userFeatures,
  hostFeatures,
  howHost,
  trust,
  testimonials,
  faqs,
} from "../data/content";
---

<BaseLayout>
  <a class="skip" href="#main">İçeriğe geç</a>

  <Nav nav={nav} />

  <main id="main">
    <Hero />
    <ValueProps items={userValueProps} />
    <ScreensGallery items={userScreenStory} />
    <Features items={userFeatures} />
    <HostSection features={hostFeatures} steps={howHost} />
    <TrustSection items={trust} />
    <Testimonials items={testimonials} />
    <FAQSection items={faqs} />
    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>
