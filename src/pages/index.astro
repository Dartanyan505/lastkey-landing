---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
import AppDownload from "../components/AppDownload.astro";
import ScreensGallery from "../components/ScreensGallery.astro";
import Features from "../components/Features.astro";
import HowUser from "../components/HowUser.astro";
import HostSection from "../components/HostSection.astro";
import FAQSection from "../components/FAQSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

import {
  nav,
  userValueProps,
  userScreenStory,
  userFeatures,
  howUser,
  hostFeatures,
  howHost,
  faqs,
} from "../data/content";
---

<BaseLayout>
  <a class="skip" href="#main">İçeriğe geç</a>

  <div class="page-glow" aria-hidden="true"></div>

  <Nav nav={nav} />

  <main id="main">
    <Hero />
    <ValueProps items={userValueProps} />
    <AppDownload />
    <ScreensGallery items={userScreenStory} />
    <Features items={userFeatures} />
    <HowUser steps={howUser} />
    <HostSection features={hostFeatures} steps={howHost} />
    <FAQSection items={faqs} />
    <FinalCTA />
  </main>

  <Footer />

  <script>
    const motionSafe = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealTargets = [
      ...document.querySelectorAll(
        [
          ".hero__copy",
          ".hero__visual",
          ".value-intro",
          ".value-rail li",
          ".download-panel",
          ".section--gallery .section__head",
          ".screens-gallery",
          ".screens-gallery__controlsbar",
          ".feature-spotlight",
          ".feature-lines li",
          ".journey__step",
          ".host-intro",
          ".host-panel",
          ".faq-layout > div:first-child",
          ".faq__item",
          ".final-cta",
          ".support-form",
          ".support-to-top-wrap",
          ".footer__brand",
          ".footer__col",
          ".footer__bottom",
        ].join(","),
      ),
    ];

    revealTargets.forEach((el, index) => {
      el.classList.add("reveal-in");
      el.style.setProperty("--reveal-delay", `${(index % 6) * 70}ms`);

      if (el.matches(".hero__copy, .value-intro, .feature-spotlight, .faq-layout > div:first-child")) {
        el.classList.add("reveal-left");
      } else if (el.matches(".hero__visual, .host-panel, .support-form, .final-cta")) {
        el.classList.add("reveal-right");
      }
    });

    if (!motionSafe || !("IntersectionObserver" in window)) {
      revealTargets.forEach((el) => el.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
      );

      revealTargets.forEach((el) => {
        const top = el.getBoundingClientRect().top;
        if (top < window.innerHeight * 0.88) {
          el.classList.add("is-visible");
        } else {
          observer.observe(el);
        }
      });
    }

    const heroVisual = document.querySelector(".hero__visual");
    const heroPhones = heroVisual?.querySelectorAll(".hero-phone");
    const canUsePointer = motionSafe && window.matchMedia("(pointer: fine)").matches;

    if (heroVisual && heroPhones?.length && canUsePointer) {
      const tiltMax = 8;

      heroVisual.addEventListener("pointermove", (event) => {
        const rect = heroVisual.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        const rx = y * -tiltMax;
        const ry = x * tiltMax;

        heroVisual.style.setProperty("--hero-tilt-x", `${rx.toFixed(2)}deg`);
        heroVisual.style.setProperty("--hero-tilt-y", `${ry.toFixed(2)}deg`);
      });

      heroVisual.addEventListener("pointerleave", () => {
        heroVisual.style.setProperty("--hero-tilt-x", "0deg");
        heroVisual.style.setProperty("--hero-tilt-y", "0deg");
      });
    }

    const tiltCards = [
      ...document.querySelectorAll(
        [
          ".value-rail li",
          ".feature-lines li",
          ".faq__item",
          ".host-feature",
        ].join(","),
      ),
    ];

    if (tiltCards.length && canUsePointer) {
      const tiltMax = 4;

      tiltCards.forEach((card) => {
        card.classList.add("tilt-card");

        card.addEventListener("pointermove", (event) => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          const rx = y * -tiltMax;
          const ry = x * tiltMax;
          card.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-2px)`;
        });

        card.addEventListener("pointerleave", () => {
          card.style.transform = "";
        });
      });
    }

    const navLinks = [...document.querySelectorAll(".nav__link[href^='#']")];
    const sections = navLinks
      .map((link) => {
        const href = link.getAttribute("href");
        if (!href) return null;
        const section = document.querySelector(href);
        return section instanceof HTMLElement ? section : null;
      })
      .filter(Boolean);

    if (navLinks.length && sections.length) {
      const setActiveLink = (id) => {
        navLinks.forEach((link) => {
          link.classList.toggle("is-active", link.getAttribute("href") === `#${id}`);
        });
      };

      const updateActiveSection = () => {
        const navHeight = document.querySelector(".nav")?.clientHeight ?? 0;
        const offsetY = window.scrollY + navHeight + 24;
        const isAtPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

        if (isAtPageBottom) {
          const lastSection = sections[sections.length - 1];
          if (lastSection?.id) setActiveLink(lastSection.id);
          return;
        }

        let activeSection = sections[0];

        sections.forEach((section) => {
          const sectionTop = section.getBoundingClientRect().top + window.scrollY;
          if (sectionTop <= offsetY) {
            activeSection = section;
          }
        });

        if (activeSection?.id) {
          setActiveLink(activeSection.id);
        }
      };

      updateActiveSection();
      window.addEventListener("scroll", updateActiveSection, { passive: true });
      window.addEventListener("resize", updateActiveSection);
    }
  </script>
</BaseLayout>
