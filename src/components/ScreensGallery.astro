---
const { items = [] } = Astro.props;
---
<section class="section section--alt section--gallery">
  <div class="container">
    <div class="section__head section__head--row">
      <div>
        <h2>Uygulamayı Yakından Gör</h2>
        <p class="muted">Aramadan rezervasyona uzanan deneyimi gerçek ekranlar üzerinden keşfet.</p>
      </div>
    </div>

    <div class="screens-gallery" data-gallery aria-label="Uygulama ekran galerisi">
      <div class="screens-gallery__track" data-gallery-track>
        {items.map((item, index) => (
          <article class="screens-gallery__item" data-slide>
            <figure class="screens-gallery__phone">
              <div class="screens-gallery__phone-top" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <img
                src={item.src}
                alt={item.alt}
                width="1080"
                height="2460"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="screens-gallery__copy">
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>

              <div class="screens-gallery__meta">
                <span>Canlı deneyim</span>
              </div>

              <ul class="screens-gallery__details">
                {((item.details && item.details.length ? item.details : []) as string[]).map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <div class="screens-gallery__controlsbar">
        <div class="screens-gallery__pager" data-gallery-pager>
          {items.map((item, index) => (
            <button
              class="screens-gallery__dot"
              type="button"
              data-go={index}
              aria-label={`${index + 1}. ekran: ${item.title}`}
            ></button>
          ))}
        </div>

        <div class="gallery-controls" data-gallery-controls>
          <button class="gallery-arrow" type="button" data-dir="-1" aria-label="Önceki ekran">
            <svg class="gallery-arrow__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14.5 6.5 9 12l5.5 5.5" />
            </svg>
          </button>
          <button class="gallery-arrow" type="button" data-dir="1" aria-label="Sonraki ekran">
            <svg class="gallery-arrow__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9.5 6.5 15 12l-5.5 5.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const galleries = document.querySelectorAll("[data-gallery]");
  const galleryVisibilityHandlers = [];

  if (galleries.length) {
    document.addEventListener("visibilitychange", () => {
      const isHidden = document.hidden;
      galleryVisibilityHandlers.forEach((handler) => handler(isHidden));
    });
  }

  galleries.forEach((gallery) => {
    const track = gallery.querySelector("[data-gallery-track]");
    const controls = gallery.querySelector("[data-gallery-controls]");
    const pager = gallery.querySelector("[data-gallery-pager]");

    if (!controls || !track) return;

    const buttons = controls.querySelectorAll("[data-dir]");
    const slides = track.querySelectorAll("[data-slide]");
    const dots = pager?.querySelectorAll("[data-go]") ?? [];
    let currentIndex = 0;
    let autoTimer = 0;
    let touchStartX = 0;
    let touchDeltaX = 0;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const goTo = (nextIndex) => {
      if (!slides.length) return;
      currentIndex = (nextIndex + slides.length) % slides.length;
      update();
    };

    const update = () => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === currentIndex);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === currentIndex);
        dot.setAttribute("aria-current", i === currentIndex ? "true" : "false");
      });
    };

    const startAutoPlay = () => {
      if (prefersReducedMotion || slides.length < 2) return;
      window.clearInterval(autoTimer);
      autoTimer = window.setInterval(() => {
        goTo(currentIndex + 1);
      }, 5000);
    };

    const stopAutoPlay = () => {
      window.clearInterval(autoTimer);
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const dir = Number(button.getAttribute("data-dir")) || 1;
        goTo(currentIndex + dir);
        startAutoPlay();
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const next = Number(dot.getAttribute("data-go"));
        if (Number.isNaN(next)) return;
        goTo(next);
        startAutoPlay();
      });
    });

    gallery.setAttribute("tabindex", "0");
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        goTo(currentIndex + 1);
        startAutoPlay();
      } else if (event.key === "ArrowLeft") {
        goTo(currentIndex - 1);
        startAutoPlay();
      }
    });

    gallery.addEventListener("mouseenter", stopAutoPlay);
    gallery.addEventListener("mouseleave", startAutoPlay);
    gallery.addEventListener("focusin", stopAutoPlay);
    gallery.addEventListener("focusout", startAutoPlay);

    gallery.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.touches[0]?.clientX ?? 0;
        touchDeltaX = 0;
        stopAutoPlay();
      },
      { passive: true },
    );

    gallery.addEventListener(
      "touchmove",
      (event) => {
        const moveX = event.touches[0]?.clientX ?? touchStartX;
        touchDeltaX = moveX - touchStartX;
      },
      { passive: true },
    );

    gallery.addEventListener(
      "touchend",
      () => {
        if (Math.abs(touchDeltaX) > 40) {
          goTo(currentIndex + (touchDeltaX < 0 ? 1 : -1));
        }
        touchDeltaX = 0;
        startAutoPlay();
      },
      { passive: true },
    );

    galleryVisibilityHandlers.push((isHidden) => {
      if (isHidden) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    });

    window.addEventListener("pagehide", stopAutoPlay);

    update();
    startAutoPlay();
  });
</script>
