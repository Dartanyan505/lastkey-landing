---
const { items = [] } = Astro.props;
---
<section class="section section--alt">
  <div class="container">
    <div class="section__head section__head--row">
      <div>
        <p class="eyebrow">Ekran Akışı</p>
        <h2>Aramadan ödemeye kadar her adım sade ve hızlı</h2>
      </div>

      <div class="gallery-controls" data-gallery-controls>
        <button class="gallery-arrow" type="button" data-dir="-1" aria-label="Önceki ekran">←</button>
        <button class="gallery-arrow" type="button" data-dir="1" aria-label="Sonraki ekran">→</button>
      </div>
    </div>

    <div class="screens-gallery" data-gallery aria-label="Uygulama ekran galerisi">
      <div class="screens-gallery__track" data-gallery-track>
        {items.map((item) => (
          <article class="screens-gallery__item">
            <figure class="screens-gallery__phone">
              <img
                src={item.src}
                alt={item.alt}
                width="1080"
                height="2460"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="screens-gallery__copy">
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const galleries = document.querySelectorAll("[data-gallery]");

  galleries.forEach((gallery) => {
    const track = gallery.querySelector("[data-gallery-track]");
    const controls = gallery.closest(".container")?.querySelector("[data-gallery-controls]");

    if (!controls || !track) return;

    const buttons = controls.querySelectorAll("[data-dir]");
    const slides = track.querySelectorAll(".screens-gallery__item");
    let currentIndex = 0;

    const update = () => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!slides.length) return;
        const dir = Number(button.getAttribute("data-dir")) || 1;
        currentIndex = (currentIndex + dir + slides.length) % slides.length;
        update();
      });
    });
  });
</script>
