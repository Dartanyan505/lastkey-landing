---
const { items = [] } = Astro.props;
---
<section class="section section--alt">
  <div class="container">
    <div class="section__head section__head--row">
      <div>
        <p class="eyebrow">Kullanıcı Yorumları</p>
        <h2>Deneyenler LastKey'i neden seviyor?</h2>
      </div>
      <p class="muted">Gerçek kullanıcı yorumlarını yayına almadan önce doğrulama yapman önerilir.</p>
    </div>

    <div class="review-grid">
      {items.map((item) => (
        <figure class="review-card">
          <blockquote>“{item.quote}”</blockquote>
          <figcaption>{item.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
