---
const { items = [] } = Astro.props;
---
<section class="section section--alt section--testimonials">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Kullanıcı Yorumları</p>
      <h2>Kullanıcılar ne diyor?</h2>
      <p class="muted">Yer tutucu metinler (sonradan gerçek yorumlarla değiştir).</p>
    </div>

    <div class="quote-stream">
      {items.map((item, index) => (
        <figure class={`quote-stream__item ${index % 2 ? "quote-stream__item--offset" : ""}`}>
          <blockquote>“{item.quote}”</blockquote>
          <figcaption>— {item.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
