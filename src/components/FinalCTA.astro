<section id="destek" class="section section--tight section--cta">
  <div class="container">
    <div class="final-cta">
      <div class="support-intro">
        <h2>Destek Formu</h2>
        <p class="muted">Sorunu veya talebini bize yaz. Ekibimiz en kısa sürede seninle iletişime geçsin.</p>

        <div class="support-contact">
          <h3>İletişim Bilgileri</h3>
          <div class="support-contact__row">
            <span>Destek Maili</span>
            <a href="mailto:destek@lastkey.app">destek@lastkey.app</a>
          </div>
          <div class="support-contact__row">
            <span>Kurumsal Mail</span>
            <a href="mailto:kurumsal@lastkey.app">kurumsal@lastkey.app</a>
          </div>
          <div class="support-contact__row">
            <span>Telefon</span>
            <a href="tel:+905551112233">+90 555 111 22 33</a>
          </div>
          <p class="muted">Pzt-Cum 09:00-18:00</p>
        </div>
      </div>

      <form class="support-form" action="#" method="post" data-form-kind="landing-support">
        <input
          class="hp-field"
          type="text"
          name="_company"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <label class="field">
          <span>Ad Soyad</span>
          <input type="text" name="name" placeholder="Ad Soyad" required />
        </label>

        <label class="field">
          <span>E-posta</span>
          <input type="email" name="email" placeholder="ornek@mail.com" required />
        </label>

        <label class="field field--full">
          <span>Mesaj</span>
          <textarea name="message" rows="4" placeholder="Destek talebini kısaca yaz." required></textarea>
        </label>

        <div class="support-form__actions">
          <button class="btn btn--lg" type="submit" data-idle-label="Gönder">Gönder</button>
        </div>
        <p class="form-status muted" data-form-status aria-live="polite"></p>
      </form>
    </div>

    <div class="support-to-top-wrap">
      <button class="support-to-top up-arrow-btn" type="button" data-to-top aria-label="Sayfanın başına dön">
        <svg class="up-arrow-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6.5 14.5 12 9l5.5 5.5" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const supportToTopButtons = document.querySelectorAll("[data-to-top]");
  supportToTopButtons.forEach((button) => {
    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
