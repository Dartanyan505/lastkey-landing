---
const { items = [] } = Astro.props;
---
<section id="sss" class="section">
  <div class="container">
    <div class="section__head">
      <h2>SSS</h2>
      <p class="muted">En çok sorulan sorular.</p>
    </div>

    <div class="faq">
      {items.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">{f.q}</summary>
          <div class="faq__a muted">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
