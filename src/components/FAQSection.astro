---
const { items = [] } = Astro.props;
---
<section id="sss" class="section section--faq">
  <div class="container faq-layout">
    <div>
      <h2>SSS</h2>
      <p class="muted">En çok sorulan sorular.</p>
    </div>

    <div class="faq">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">{item.q}</summary>
          <div class="faq__a">{item.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
