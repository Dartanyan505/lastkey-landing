<section id="uygulama" class="section">
  <div class="container">
    <div class="download-panel">
      <div>
        <p class="eyebrow">Mobil Deneyim</p>
        <h2>Uygulamayı indir, indirimli odaları saniyeler içinde yakala</h2>
        <p class="muted">
          LastKey iOS ve Android'de hızlı çalışır. Konumuna yakın otelleri canlı görün,
          uygun fiyatı kaçırmadan rezervasyonu tamamla.
        </p>
      </div>

      <div class="download-panel__actions" aria-label="Mağaza bağlantıları">
        <a
          class="store-link"
          href="https://apps.apple.com/tr"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="App Store'dan indir"
        >
          <img
            class="store-badge store-badge--apple"
            src="/badges/app-store.svg"
            alt="Download on the App Store"
            loading="lazy"
            decoding="async"
          />
        </a>

        <a
          class="store-link"
          href="https://play.google.com/store/apps"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Play'den indir"
        >
          <img
            class="store-badge store-badge--google"
            src="/badges/google-play.png"
            alt="Get it on Google Play"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
  </div>
</section>
