---
import { screenShotPaths } from "../data/content";

const heroBackShot = screenShotPaths[1] ?? screenShotPaths[0] ?? "/screen-shots/ana-sayfa.jpg";
const heroFrontShot = screenShotPaths[0] ?? "/screen-shots/ana-sayfa.jpg";
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <img
        class="hero__wordmark-logo"
        src="/image.png"
        alt="LastKey"
        width="1600"
        height="444"
        loading="eager"
        decoding="async"
      />
      <h1>Son dakika indirimli odayı hızlıca bul.</h1>
      <p class="lead">
        LastKey son dakika aramada indirimli oda seçeneklerini tek ekranda toplar. Karşılaştır, seç ve rezervasyonunu hızla tamamla.
      </p>

      <div class="hero__cta">
        <a class="btn btn--lg" href="#otel-sahipleri">Otelimi Listele</a>
        <a class="btn btn--lg btn--ghost" href="#uygulama">Otelleri Gör</a>
      </div>

    </div>

    <div class="hero__visual" aria-label="LastKey ekran görüntüleri">
      <figure class="hero-phone hero-phone--back">
        <img
          class="hero-phone__shot"
          src={heroBackShot}
          alt="LastKey favori oteller ekranı"
          width="1080"
          height="2460"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="hero-phone hero-phone--front">
        <img
          class="hero-phone__shot"
          src={heroFrontShot}
          alt="LastKey uygulaması ana sayfa ekranı"
          width="1080"
          height="2460"
          loading="eager"
          decoding="async"
        />
      </figure>

    </div>
  </div>
</section>
