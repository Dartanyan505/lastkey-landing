---
const { features = [], steps = [] } = Astro.props;
---
<section id="otel-sahipleri" class="section section--alt">
  <div class="container">
    <div class="two">
      <div>
        <h2>Boş kalacak odaları indirimli sat, gelire dönüştür.</h2>
        <p class="lead">
          LastKey ile normalde boş kalacak odaları son dakika misafirlerine daha uygun fiyatla sun, doluluğunu ve kârını artır.
        </p>
        <div class="cta-row">
          <a class="btn btn--lg" href="/basvuru-gonder">Başvuru Gönder</a>
          <a class="btn btn--lg btn--ghost" href="#sss">SSS</a>
        </div>
      </div>

      <div class="panel">
        <h3>Otel Sahibi Özellikleri</h3>
        <div class="panel__grid">
          {features.map((f) => (
            <div class="panel__item">
              <div class="panel__title">{f.title}</div>
              <div class="muted">{f.desc}</div>
            </div>
          ))}
        </div>

        <h3 style="margin-top:18px;">Nasıl Çalışır?</h3>
        <ol class="steps steps--compact">
          {steps.map((s) => (
            <li class="step step--compact">
              <div class="step__num"></div>
              <div class="step__txt">{s}</div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
