---
const { features = [], steps = [] } = Astro.props;
---
<section id="otel-sahipleri" class="section section--host">
  <div class="container">
    <div class="host-wrap">
      <div class="host-intro">
        <h2>Boş kalacak odaları indirimli sat, gelire dönüştür.</h2>
        <p class="lead">
          LastKey ile normalde boş kalacak odaları son dakika misafirlerine daha uygun fiyatla sun, doluluğunu ve kârını artır.
        </p>
        <div class="cta-row">
          <a class="btn btn--lg" href="/basvuru-gonder">Otelimi Listele</a>
          <a class="btn btn--lg btn--ghost" href="#sss">SSS</a>
        </div>
      </div>

      <div class="host-panel">
        <h3>Otel Sahibi Özellikleri</h3>
        <div class="host-feature-grid">
          {features.map((feature) => (
            <article class="host-feature">
              <h4>{feature.title}</h4>
              <p class="muted">{feature.desc}</p>
            </article>
          ))}
        </div>

        <h3>Nasıl Çalışır?</h3>
        <ol class="mini-steps">
          {steps.map((step, index) => (
            <li>
              <span>{index + 1}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
