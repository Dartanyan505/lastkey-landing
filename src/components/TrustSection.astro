---
const { items = [] } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Güven</p>
      <h2>Hem kullanıcı hem işletme için kontrollü rezervasyon altyapısı</h2>
    </div>

    <div class="trust-grid">
      {items.map((item) => (
        <article class="trust-card">
          <span aria-hidden="true">◆</span>
          <p>{item}</p>
        </article>
      ))}
    </div>
  </div>
</section>
