---
const { items = [] } = Astro.props;
---
<section id="kesfet" class="section section--tight">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Neden LastKey?</p>
      <h2>Plansız seyahatler için tasarlanmış modern rezervasyon akışı</h2>
    </div>

    <div class="value-grid">
      {items.map((item) => (
        <article class="value-card">
          <span class="value-card__dot" aria-hidden="true"></span>
          <p>{item}</p>
        </article>
      ))}
    </div>
  </div>
</section>
