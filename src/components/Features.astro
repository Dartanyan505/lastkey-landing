---
const { items = [] } = Astro.props;
---
<section class="section section--features">
  <div class="container">
    <div class="feature-split">
      <aside class="feature-spotlight">
        <p class="eyebrow">Özellikler</p>
        <h2>İndirimli oda bulmayı hızlandıran özellikler</h2>
        <p class="muted">Konum ve filtrelerle son dakika indirimli odaya saniyeler içinde ulaş.</p>
      </aside>

      <ul class="feature-lines">
        {items.map((item, index) => (
          <li>
            <span class="feature-lines__index">0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
