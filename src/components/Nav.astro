---
const { nav = [] } = Astro.props;
---
<header class="nav">
  <div class="container nav__inner">
    <a class="brand" href="/" aria-label="LastKey ana sayfa">
      <img class="brand__logo" src="/image.png" alt="LastKey" width="1600" height="444" />
      <span class="brand__tag">Plansız seyahatlerin anahtarı</span>
    </a>

    <nav class="nav__links" aria-label="Ana menü">
      {nav.map((item) => (
        <a class="nav__link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="nav__cta">
      <a class="btn" href="#otel-sahipleri">Otelimi Listele</a>
      <a class="btn btn--ghost" href="#kesfet">Otelleri Gör</a>
    </div>
  </div>
</header>
