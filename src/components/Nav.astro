---
type NavItem = {
  label: string;
  href: string;
};

const { nav = [] } = Astro.props as { nav?: NavItem[] };
---
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="brand" href="/" aria-label="LastKey ana sayfa">
      <img class="brand__logo" src="/image.png" alt="LastKey" width="1600" height="444" />
      <span class="brand__tag">Plansız seyahatlerin anahtarı</span>
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-links"
      aria-label="Menüyü aç"
      data-nav-toggle
    >
      Menü
    </button>

    <nav class="nav__links" id="site-nav-links" aria-label="Ana menü">
      {nav.map((item) => (
        <a class="nav__link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="nav__cta">
      <a class="btn" href="#otel-sahipleri">Otelimi Listele</a>
      <a class="btn btn--ghost" href="#kesfet">Otelleri Gör</a>
    </div>
  </div>
</header>

<script>
  const navRoot = document.querySelector("[data-nav]");
  const navToggle = navRoot?.querySelector("[data-nav-toggle]");
  const navLinks = navRoot?.querySelectorAll(".nav__link");

  if (navRoot && navToggle instanceof HTMLButtonElement) {
    const closeNav = () => {
      navRoot.classList.remove("is-open");
      navToggle.setAttribute("aria-expanded", "false");
      navToggle.setAttribute("aria-label", "Menüyü aç");
    };

    navToggle.addEventListener("click", () => {
      const shouldOpen = !navRoot.classList.contains("is-open");
      navRoot.classList.toggle("is-open", shouldOpen);
      navToggle.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
      navToggle.setAttribute("aria-label", shouldOpen ? "Menüyü kapat" : "Menüyü aç");
    });

    navLinks?.forEach((link) => {
      link.addEventListener("click", closeNav);
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeNav();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 780) closeNav();
    });
  }
</script>
