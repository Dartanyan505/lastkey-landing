---
const { steps = [] } = Astro.props;
---
<section id="nasil-calisir" class="section section--alt section--timeline">
  <div class="container">
    <div class="journey-head">
      <div>
        <h2>Nasıl Çalışır?</h2>
      </div>
      <p class="muted">Birkaç adımda rezervasyonunu tamamla.</p>
    </div>

    <ol class="journey">
      {steps.map((step, index) => (
        <li class="journey__step">
          <span class="journey__pin">{index + 1}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
